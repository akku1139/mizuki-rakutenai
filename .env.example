# Discord bot token (required)
DISCORD_TOKEN=

# Fluxer bot token (required)
FLUXER_TOKEN=

# Logging webhooks
DISCORD_LOG_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
FLUXER_LOG_WEBHOOK_ID=<id>
FLUXER_LOG_WEBHOOK_TOKEN=<token>

# --- AI settings (optional) ---
# Default provider when a user has not chosen one: rakutenai | openai
#AI_PROVIDER=rakutenai

# OpenAI-compatible API settings (used when AI_PROVIDER=openai, or a user runs "@bot aimodel openai")
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# --- AI tools for the openai provider (optional) ---
# Web page reading endpoint (Mozilla Readability server). Enables the read_web tool.
#READABILITY_ENDPOINT=https://example.com/readability
# Web search endpoint. Enables the search_web tool.
#SEARCH_ENDPOINT=https://example.com/searchep
