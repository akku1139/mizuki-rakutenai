# Discord ボットのトークン (必須)
DISCORD_TOKEN=

# Fluxer ボットのトークン (必須)
FLUXER_TOKEN=

# サーバーログを送る webhook (必須)
DISCORD_LOG_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
FLUXER_LOG_WEBHOOK_ID=<id>
FLUXER_LOG_WEBHOOK_TOKEN=<token>

# --- AI の設定 (任意) ---
# ユーザーがプロバイダを選んでいないときの既定値: rakutenai | openai
#AI_PROVIDER=rakutenai

# OpenAI 互換 API の設定 (AI_PROVIDER=openai のとき、またはユーザーが "@bot aimodel openai" を実行したときに使用)
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# --- openai プロバイダ用の AI ツール (任意) ---
# Web ページ閲覧のエンドポイント (Mozilla Readability サーバー)。設定すると read_web ツールが有効になる
#READABILITY_ENDPOINT=https://example.com/readability
# Web 検索のエンドポイント。設定すると search_web ツールが有効になる
#SEARCH_ENDPOINT=https://example.com/searchep

# --- MiQ (任意) ---
# 引用画像 API (https://miq.otnc.dev) のキー。Fluxer の "めいく" / "make" で使用
#OPENMIQ_TOKEN=
